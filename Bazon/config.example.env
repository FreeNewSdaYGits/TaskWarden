# Пример переменных окружения. Секреты задаются в интерфейсе Amvera («Переменные»),
# в репозиторий и в этот файл не попадают.

# Bazon
BAZON_LOGIN=c1575_external_app
BAZON_TOKEN_PATH=/data/bz_token.json

# Telegram: бот должен быть админом группы
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-100XXXXXXXXXX
TELEGRAM_TOPIC_REPORT=<id топика «Отчёты»>
TELEGRAM_TOPIC_CASH=<id топика «Касса»>

# Режим: 0 — только журнал, 1 — отправка в Telegram
SEND=0

# Расписание и опрос
REPORT_AT=19:30
POLL_SECONDS=60

# Файлы состояния на постоянном диске
STATE_PATH=/data/cash_state.json
REPORT_STATE=/data/report_state.json
LOG_PATH=/data/app.log
